<Application x:Class="MinecraftResourceCalculator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MinecraftResourceCalculator.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
            <conv:CountToVisibilityConverter x:Key="CountToVisConverter"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
            <conv:StringToVisibilityConverter x:Key="StringToVisConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
